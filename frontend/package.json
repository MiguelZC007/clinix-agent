    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.17",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "jsdom": "^27.4.0",
    "knip": "^5.85.0",
    "msw": "^2.12.7",
