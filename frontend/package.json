    "jotai": "^2.15.1",
    "lucide-react": "^0.553.0",
    "next": "15.5.9",
    "next-auth": "^4.24.13",
    "next-intl": "^4.5.3",
    "next-themes": "^0.4.6",
    "react": "19.1.2",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.1.2",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^9.0.1",
